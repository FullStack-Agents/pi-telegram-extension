{
  "name": "pi-telegram-extension",
  "version": "1.0.0",
  "description": "Telegram bridge for the Pi coding agent. Loaded by trout-pi-agent from dist/index.js.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@sinclair/typebox": "0.34.52",
    "node-telegram-bot-api": "0.67.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/node-telegram-bot-api": "0.64.15",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
