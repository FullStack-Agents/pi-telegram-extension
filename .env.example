# Bot token from @BotFather. Required.
# TELEGRAM_BOT_TOKEN=

# Allowlist is on unless you set this to false, 0, no, or off.
# TELEGRAM_ALLOWLIST_ENABLED=true

# Comma-separated Telegram user ids that may message the bot.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# Comma-separated group chat ids (usually negative, for example -1001234567890).
# TELEGRAM_ALLOWED_GROUP_CHAT_IDS=

# Where downloaded photos, documents, and voice files are stored.
# Default: the OS temp directory, in a pi-telegram folder.
# TELEGRAM_DOWNLOAD_DIR=

# Optional speech-to-text command. The downloaded voice or video-note file is
# appended as the last argument. stdout becomes the message text.
# TELEGRAM_TRANSCRIBE_COMMAND="/path/to/python3 /path/to/transcribe.py"
